# Example SAM config — copy to samconfig.toml and fill in values
# Do NOT commit the actual samconfig.toml with real values

version = 0.1

[default.deploy.parameters]
stack_name = "saans-dev"
resolve_s3 = true
s3_prefix = "saans"
region = "ap-south-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"
parameter_overrides = "Stage=dev"
confirm_changeset = true
